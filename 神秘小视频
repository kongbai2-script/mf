local user, repo, branch = "kongbai2-script", "MP3-PNG", "main"
local base = "https://cdn.jsdelivr.net/gh/"..user.."/"..repo.."@"..branch.."/"

local loadGui = Instance.new("ScreenGui")
loadGui.IgnoreGuiInset = true
loadGui.Parent = game.CoreGui

local bg = Instance.new("Frame", loadGui)
bg.Size = UDim2.new(1, 0, 1, 0)
bg.BackgroundColor3 = Color3.new(0, 0, 0)
bg.BorderSizePixel = 0

local barBg = Instance.new("Frame", bg)
barBg.Size = UDim2.new(0, 400, 0, 24)
barBg.Position = UDim2.new(0.5, -200, 0.5, -12)
barBg.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
barBg.BorderSizePixel = 0

local barFill = Instance.new("Frame", barBg)
barFill.Size = UDim2.new(0, 0, 1, 0)
barFill.BackgroundColor3 = Color3.new(1, 1, 1)
barFill.BorderSizePixel = 0

local label = Instance.new("TextLabel", bg)
label.Size = UDim2.new(0, 400, 0, 30)
label.Position = UDim2.new(0.5, -200, 0.5, 28)
label.BackgroundTransparency = 1
label.TextColor3 = Color3.new(1, 1, 1)
label.Font = Enum.Font.Gotham
label.TextSize = 20
label.Text = "[0/0]"

local function fadeOut()
    local ts = game:GetService("TweenService")
    local info = TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    for _, obj in ipairs(loadGui:GetDescendants()) do
        if obj:IsA("Frame") then
            ts:Create(obj, info, {BackgroundTransparency = 1}):Play()
        elseif obj:IsA("TextLabel") then
            ts:Create(obj, info, {TextTransparency = 1}):Play()
        end
    end
    task.wait(0.5)
    loadGui:Destroy()
end

local function download()
    local tree = game:GetService("HttpService"):JSONDecode(game:HttpGet(
        "https://api.github.com/repos/"..user.."/"..repo.."/git/trees/"..branch.."?recursive=1")).tree

    local queue = {}
    for _, item in ipairs(tree) do
        local path = item.path
        if path:match("^frames/") then
            local localPath = path
            if path:match("^frames/MP3/") then
                localPath = "frames/"..path:match("([^/]+)$")
            end
            if not isfile(localPath) then
                table.insert(queue, {remote = path, localPath = localPath})
            end
        end
    end

    local total = #queue
    if total == 0 then return end

    local done = 0
    local index = 1
    local CONCURRENT = 30
    local remaining = CONCURRENT
    if total < CONCURRENT then remaining = total end

    local function worker()
        while index <= total do
            local i = index
            index = index + 1
            local item = queue[i]
            if not item then break end
            local dir = item.localPath:match("^(.*)/[^/]*$")
            if dir and not isfolder(dir) then makefolder(dir) end
            pcall(function()
                writefile(item.localPath, game:HttpGet(base..item.remote))
            end)
            done = done + 1
            label.Text = "["..done.."/"..total.."]"
            barFill.Size = UDim2.new(done/total, 0, 1, 0)
        end
        remaining = remaining - 1
    end

    for i = 1, math.min(CONCURRENT, total) do
        task.spawn(worker)
    end
    while remaining > 0 do
        task.wait()
    end
end

if not isfolder("frames") or #listfiles("frames") < 270 then
    download()
end

fadeOut()

local files = listfiles("frames")
table.sort(files)

local assets = {}
for _, f in ipairs(files) do
    if f:match("%.jpg$") then
        table.insert(assets, getcustomasset(f:gsub("\\", "/")))
    end
end

local sound = Instance.new("Sound")
local mp3 = "frames/39111822397-1-192.mp3"
if not isfile(mp3) then mp3 = "frames/MP3/39111822397-1-192.mp3" end
sound.SoundId = getcustomasset(mp3)
sound.Parent = game:GetService("SoundService")

repeat task.wait() until sound.TimeLength > 0
local fps = #assets / sound.TimeLength

local gui = Instance.new("ScreenGui")
gui.IgnoreGuiInset = true
gui.Parent = game.CoreGui

local vbg = Instance.new("Frame", gui)
vbg.Size = UDim2.new(1, 0, 1, 0)
vbg.BackgroundColor3 = Color3.new(0, 0, 0)
vbg.BorderSizePixel = 0

local vp = workspace.CurrentCamera.ViewportSize
local h = vp.Y * 0.8
local w = h * 4 / 3

local a = Instance.new("ImageLabel", vbg)
a.Size = UDim2.new(0, w, 0, h)
a.Position = UDim2.new(0.5, -w/2, 0.5, -h/2)
a.BackgroundTransparency = 1
a.ZIndex = 2

local b = Instance.new("ImageLabel", vbg)
b.Size = a.Size
b.Position = a.Position
b.BackgroundTransparency = 1
b.ZIndex = 1

a.Image = assets[1]
sound:Play()

local n = #assets
local last = 0
while sound.Playing and sound.TimePosition < sound.TimeLength do
    local idx = math.clamp(math.floor(sound.TimePosition * fps) + 1, 1, n)
    if idx ~= last then
        b.Image = assets[idx]
        b.ZIndex = 3
        a.ZIndex = 1
        a, b = b, a
        last = idx
    end
    task.wait()
end

gui:Destroy()
